<Page x:Class="PZ6.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Autho" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword"/>

            <TextBlock x:Name="tblCaptcha" Text="Введите капчу:" Visibility="Hidden"/>
            <TextBox x:Name="tbCaptcha" Visibility="Hidden"/>
            <TextBlock x:Name="tbiCaptcha" Visibility="Hidden" 
                       TextDecorations="Strikethrough" FontWeight="Bold" FontSize="18" 
                       HorizontalAlignment="Center" Margin="5"/>

            <StackPanel Orientation="Horizontal" Height="80" HorizontalAlignment="Center">
                <Button x:Name="btnEnterGuests" Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Content="Войти" Click="btnEnter_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>